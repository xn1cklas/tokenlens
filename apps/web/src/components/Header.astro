---
// Header component
---

<header class="header">
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">
        <span class="logo-text">tokenlens</span>
      </a>
      <div class="nav-links">
        <button id="search-button" class="nav-link search-btn" title="Search (Cmd+K)">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.33333 12.6667C10.2789 12.6667 12.6667 10.2789 12.6667 7.33333C12.6667 4.38781 10.2789 2 7.33333 2C4.38781 2 2 4.38781 2 7.33333C2 10.2789 4.38781 12.6667 7.33333 12.6667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M14 14L11.1 11.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="kbd">⌘K</span>
        </button>
        <a href="/initiative" class="nav-link">Initiative</a>
        <a href="/guides/overview/" class="nav-link">Docs</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid hsl(var(--border));
    padding: 1rem 0;
    position: sticky;
    top: 0;
    background: hsl(var(--background));
    backdrop-filter: blur(10px);
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    font-weight: 600;
    font-size: 1.25rem;
    transition: opacity 0.2s;
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo-text {
    font-family: "Monaco", "Courier New", monospace;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.95rem;
    transition: opacity 0.2s;
    border: none;
    background: none;
    cursor: pointer;
    color: hsl(var(--foreground));
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-btn {
    padding: 0.4rem 0.8rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    background: hsl(var(--muted));
    justify-content: center;
  }

  .search-btn svg {
    display: block;
  }

  .kbd {
    font-family: "Monaco", "Courier New", monospace;
    font-size: 0.85rem;
    opacity: 0.7;
    display: flex;
    align-items: center;
  }

  @media (max-width: 640px) {
    .nav-links {
      gap: 1rem;
    }

    .kbd {
      display: none;
    }
  }
</style>

<script>
  // Navigate to docs to use Starlight search
  function openDocsSearch() {
    window.location.href = '/guides/overview/';
    // After navigation, trigger search (Starlight will handle it)
    setTimeout(() => {
      const searchButton = document.querySelector('[data-open-modal]') as HTMLButtonElement;
      if (searchButton) {
        searchButton.click();
      }
    }, 100);
  }

  document.getElementById('search-button')?.addEventListener('click', openDocsSearch);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      // If we're already in docs, let Starlight handle it
      if (window.location.pathname.startsWith('/guides/') || 
          window.location.pathname.startsWith('/integrations/') || 
          window.location.pathname.startsWith('/reference/')) {
        // Let Starlight's search handle it
        return;
      }
      openDocsSearch();
    }
  });
</script>

