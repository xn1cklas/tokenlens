<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <p class="footer-text">
        Created by <a href="https://github.com/xn1cklas" target="_blank" rel="noopener noreferrer" class="footer-link">Nicklas</a>
      </p>
      <div class="footer-links">
        <a href="https://github.com/xn1cklas/tokenlens" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
        <a href="https://www.npmjs.com/package/tokenlens" target="_blank" rel="noopener noreferrer" class="footer-link">npm</a>
        <a href="https://github.com/xn1cklas/tokenlens/blob/v2/LICENSE" target="_blank" rel="noopener noreferrer" class="footer-link">MIT License</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid hsl(var(--border));
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-text {
    font-size: 0.9rem;
    color: hsl(var(--muted-foreground));
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-link {
    font-size: 0.9rem;
    color: hsl(var(--muted-foreground));
    transition: color 0.2s;
  }

  .footer-link:hover {
    color: hsl(var(--foreground));
    opacity: 1;
  }

  @media (max-width: 640px) {
    .footer-content {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

