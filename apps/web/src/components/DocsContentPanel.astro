---
import type { Props } from "@astrojs/starlight/props";
import Default from "@astrojs/starlight/components/ContentPanel.astro";
---

<Default {...Astro.props}>
  <slot />
</Default>

<style is:global>
  /* Add copy button next to h1 */
  .sl-markdown-content > h1 {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .copy-markdown-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .copy-markdown-button:hover {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-text);
  }

  .copy-markdown-button svg {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .copy-markdown-button {
      padding: 0.4rem 0.6rem;
      font-size: 0.8rem;
    }

    .button-text {
      display: none;
    }
  }
</style>

<script>
  function addCopyButton() {
    const h1 = document.querySelector('.sl-markdown-content > h1');
    if (!h1 || document.getElementById('copy-markdown-btn')) return;

    // Create button
    const button = document.createElement('button');
    button.id = 'copy-markdown-btn';
    button.className = 'copy-markdown-button';
    button.title = 'Copy page as Markdown';
    button.innerHTML = `
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="5" y="5" width="9" height="9" rx="1" stroke="currentColor" stroke-width="1.5"/>
        <path d="M3 11V3C3 2.44772 3.44772 2 4 2H10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="button-text">Copy Markdown</span>
    `;

    // Add to h1
    h1.appendChild(button);

    // Add click handler
    button.addEventListener('click', copyPageAsMarkdown);
  }

  async function copyPageAsMarkdown() {
    const button = document.getElementById('copy-markdown-btn');
    const buttonText = button?.querySelector('.button-text');
    if (!buttonText) return;

    try {
      // Get the main content area
      const content = document.querySelector('.sl-markdown-content');
      if (!content) {
        console.error('Content not found');
        return;
      }

      // Get page title (without the button text)
      const h1Clone = document.querySelector('h1')?.cloneNode(true) as HTMLElement;
      if (h1Clone) {
        h1Clone.querySelector('.copy-markdown-button')?.remove();
      }
      const title = h1Clone?.textContent?.trim() || 'Documentation';
      
      let markdown = `# ${title}\n\n`;

      // Process all elements in the content
      const elements = content.querySelectorAll('h2, h3, h4, p, ul, ol, pre, blockquote, table');
      
      elements.forEach((el) => {
        // Skip if element is inside a pre tag (already handled)
        if (el.closest('pre') && el.tagName !== 'PRE') return;
        
        if (el.tagName === 'H2') {
          markdown += `\n## ${el.textContent}\n\n`;
        } else if (el.tagName === 'H3') {
          markdown += `\n### ${el.textContent}\n\n`;
        } else if (el.tagName === 'H4') {
          markdown += `\n#### ${el.textContent}\n\n`;
        } else if (el.tagName === 'P') {
          const text = el.textContent?.trim();
          if (text) {
            markdown += `${text}\n\n`;
          }
        } else if (el.tagName === 'UL' && !el.closest('ul')) {
          const items = el.querySelectorAll(':scope > li');
          items.forEach(item => {
            markdown += `- ${item.textContent?.trim()}\n`;
          });
          markdown += '\n';
        } else if (el.tagName === 'OL' && !el.closest('ol')) {
          const items = el.querySelectorAll(':scope > li');
          items.forEach((item, index) => {
            markdown += `${index + 1}. ${item.textContent?.trim()}\n`;
          });
          markdown += '\n';
        } else if (el.tagName === 'PRE') {
          const code = el.querySelector('code');
          if (code) {
            const classAttr = code.className || '';
            const langMatch = classAttr.match(/language-(\w+)/);
            const language = langMatch ? langMatch[1] : '';
            markdown += `\`\`\`${language}\n${code.textContent}\n\`\`\`\n\n`;
          }
        } else if (el.tagName === 'BLOCKQUOTE') {
          const lines = el.textContent?.split('\n') || [];
          lines.forEach(line => {
            const trimmed = line.trim();
            if (trimmed) {
              markdown += `> ${trimmed}\n`;
            }
          });
          markdown += '\n';
        } else if (el.tagName === 'TABLE') {
          const rows = el.querySelectorAll('tr');
          rows.forEach((row, rowIndex) => {
            const cells = row.querySelectorAll('th, td');
            const cellTexts = Array.from(cells).map(cell => cell.textContent?.trim() || '');
            markdown += `| ${cellTexts.join(' | ')} |\n`;
            
            if (rowIndex === 0 && row.querySelector('th')) {
              markdown += `| ${cellTexts.map(() => '---').join(' | ')} |\n`;
            }
          });
          markdown += '\n';
        }
      });

      await navigator.clipboard.writeText(markdown.trim());
      
      buttonText.textContent = 'Copied!';
      setTimeout(() => {
        buttonText.textContent = 'Copy Markdown';
      }, 2000);
    } catch (err) {
      console.error('Failed to copy:', err);
      buttonText.textContent = 'Failed';
      setTimeout(() => {
        buttonText.textContent = 'Copy Markdown';
      }, 2000);
    }
  }

  // Add button when page loads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', addCopyButton);
  } else {
    addCopyButton();
  }
</script>

