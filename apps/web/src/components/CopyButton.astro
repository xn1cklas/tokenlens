---
// Copy button component
---

<button id="copy-button" class="copy-button" data-command="npm i tokenlens">
  npm i tokenlens
</button>

<style>
  .copy-button {
    position: relative;
    padding: 1.5rem 3rem;
    font-family: "Monaco", "Courier New", monospace;
    font-size: 2rem;
    font-weight: 500;
    background: hsl(var(--card));
    color: hsl(var(--card-foreground));
    border: 4px solid hsl(var(--foreground));
    border-radius: 1rem;
    cursor: pointer;
    user-select: none;
    transition: all 150ms ease;
    transform: translateY(0);
    box-shadow: 8px 8px 0px 0px hsl(var(--foreground));
  }

  .copy-button:hover {
    background: hsl(var(--secondary));
  }

  .copy-button:active,
  .copy-button.pressed {
    transform: translateY(4px);
    box-shadow: none;
  }

  @media (max-width: 768px) {
    .copy-button {
      font-size: 1.5rem;
      padding: 1.25rem 2.5rem;
      box-shadow: 6px 6px 0px 0px hsl(var(--foreground));
    }
  }

  @media (max-width: 480px) {
    .copy-button {
      font-size: 1.1rem;
      padding: 1rem 2rem;
      box-shadow: 4px 4px 0px 0px hsl(var(--foreground));
    }
  }
</style>

<script>
  import confetti from "canvas-confetti";

  const button = document.getElementById("copy-button");
  
  if (button) {
    const command = button.getAttribute("data-command") || "";

    button.addEventListener("mousedown", () => {
      button.classList.add("pressed");
    });

    button.addEventListener("mouseup", async () => {
      button.classList.remove("pressed");
      
      try {
        await navigator.clipboard.writeText(command);
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 },
        });
      } catch (err) {
        console.error("Failed to copy:", err);
      }
    });

    button.addEventListener("mouseleave", () => {
      button.classList.remove("pressed");
    });

    // Touch support
    button.addEventListener("touchstart", () => {
      button.classList.add("pressed");
    });

    button.addEventListener("touchend", async (e) => {
      e.preventDefault();
      button.classList.remove("pressed");
      
      try {
        await navigator.clipboard.writeText(command);
        confetti({
          particleCount: 100,
          spread: 70,
          origin: { y: 0.6 },
        });
      } catch (err) {
        console.error("Failed to copy:", err);
      }
    });
  }
</script>

