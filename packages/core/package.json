{
  "name": "@tokenlens/core",
  "version": "2.0.0",
  "private": false,
  "description": "Core DTOs, errors, model id helpers, and usage types for Tokenlens.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dto": {
      "types": "./dist/dto.d.ts",
      "default": "./dist/dto.js"
    },
    "./id": {
      "types": "./dist/id.d.ts",
      "default": "./dist/id.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "default": "./dist/usage.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "default": "./dist/error.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config ../../vitest.config.ts --project core",
    "test:run": "vitest run --config ../../vitest.config.ts --project core",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xn1cklas/tokenlens.git",
    "directory": "packages/core"
  },
  "keywords": [
    "ai",
    "llm",
    "model metadata",
    "types",
    "context window",
    "token usage",
    "pricing"
  ],
  "author": "Nicklas Scharpff <hi@n1cklas.com> (https://n1cklas.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xn1cklas/tokenlens/issues"
  },
  "homepage": "https://github.com/xn1cklas/tokenlens/tree/HEAD/packages/core#readme",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
